# Placeholder for the settings generated by `nixos-generate-config` on `srv`.
# Replace this module's body with the generated output and do not hand-edit
# the generated settings afterwards.
{ lib, ... }:

{
  flake.nixosModules.srv-hardware =
    { ... }:
    {
      # Stand-in so NixOS can evaluate its "root file system" assertion during
      # `nix flake check`/`dry-build`; replace with the generated values.
      fileSystems."/" = {
        device = "/dev/disk/by-label/nixos";
        fsType = "ext4";
      };

      nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
    };
}
